# ==============================================================
# ANTIGRAVITY YOUTUBE CREATOR AI STUDIO - CONFIGURATION
# ==============================================================

# Server Port
PORT=5000

# Google OAuth 2.0 Credentials (for YouTube Studio & Data APIs)
# Get from: https://console.cloud.google.com/apis/credentials
# Ensure redirect URI includes: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Optional: Google API Key (for public video research & search fallback)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API Key (for ChatGPT Creator Assistant, Scripts, SEO & DALL-E)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Demo mode toggle (true = realistic Gujarati creator sample data when credentials are empty)
DEMO_MODE=true
